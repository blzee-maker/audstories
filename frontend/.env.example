# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is already in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# "Project URL"  (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Publishable key ("sb_publishable_...", Dashboard → API Keys).
# Safe to expose: it ships in the browser bundle by design, and row-level
# security in schema.sql is what actually protects your data.
# Legacy "anon public" keys still work — supabase-js sends either one the same
# way — but new projects should use the publishable key.
VITE_SUPABASE_ANON_KEY=

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the running FastAPI backend.
# For local development this is always http://localhost:8000
# For a deployed backend, set this to your server's public URL.
VITE_API_BASE_URL=http://localhost:8000
