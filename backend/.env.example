# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is already in .gitignore.
#
# ── Just want to try the pipeline? ────────────────────────────────────────────
# Set AS_DEV_NO_AUTH=1 (bottom of this file) and you can leave every Supabase
# value blank. You still need GEMINI_API_KEY for story analysis and TTS.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Not required when AS_DEV_NO_AUTH=1.
#
# The backend uses Supabase ONLY to verify who a user is. Projects and jobs live
# in local SQLite. On the current "JWT Signing Keys" model it holds no secret at
# all: user tokens are signed with an asymmetric key and verified against your
# project's PUBLIC JWKS endpoint, which is derived from SUPABASE_URL below.

# "Project URL"  (e.g. https://xxxxxxxxxxxx.supabase.co)
# This is all the backend needs to verify tokens.
SUPABASE_URL=

# Publishable key ("sb_publishable_...", Dashboard → API Keys).
# Public by design — it is meant to ship inside a browser bundle.
# Optional here: used only as a fallback that asks Supabase to validate a token
# when local verification fails. Legacy "anon public" keys also work.
SUPABASE_ANON_KEY=

# ── LEGACY: only for projects still on the old shared JWT secret ──────────────
# Dashboard → JWT Keys → Legacy JWT Secret.
#
# LEAVE THIS BLANK if your project uses JWT Signing Keys. It is a symmetric
# secret — anyone holding it can mint valid tokens for your project — so not
# needing it is the main reason to migrate.
#
# Set it only if your tokens still arrive signed with HS256.
SUPABASE_JWT_SECRET=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey → Create API key
# Used for story NLP analysis (Stage 1) and TTS voice synthesis (Stage 2).
GEMINI_API_KEY=

# Optional TTS overrides. Defaults are sensible; set these only to change them.
# Confirm a valid model id for your key with:
#   python -m narration_tts.list_tts_models
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Algieba
# GEMINI_TTS_TEMPERATURE=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost:5173 and localhost:5174 when this is blank.
# Set this to your deployed frontend URL for production.
CORS_ORIGINS=

# ── Optional overrides ────────────────────────────────────────────────────────
# Relocate the runtime workspace (projects, audio output, SQLite DB).
# Leave blank to use the default: <repo-root>/workspace/
# AS_WORKSPACE_DIR=

# ── Local development: skip authentication ────────────────────────────────────
# Set to 1 to disable auth entirely and treat every request as a local user.
# This lets you run the whole pipeline without creating a Supabase project —
# the API only uses Supabase for auth; projects and jobs live in local SQLite.
#
# Drive it through the interactive docs at http://localhost:8000/docs, or the
# CLIs in backend/. The React frontend still needs Supabase: several of its
# pages read and write those tables directly, so it is not covered by this flag.
#
# SAFETY: the server refuses to start with this set if CORS_ORIGINS contains any
# non-local origin. Never enable it on a machine reachable from a network you do
# not control.
# AS_DEV_NO_AUTH=1
