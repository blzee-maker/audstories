# Keep the build context small and reproducible. Without this the context
# includes .venv (multi-GB) and node_modules, which slows every build.

.git
.gitignore
.dockerignore

# Virtualenvs and node deps - reinstalled inside the image
.venv/
venv/
**/node_modules/
frontend/dist/

# Python caches and build artefacts
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
.coverage
htmlcov/

# Runtime state - mounted as a volume instead
workspace/
backend/workspace/
output/
backend/output/
backend/audio_engine/output/

# Secrets never belong in an image layer
**/.env

# Editor / OS
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
